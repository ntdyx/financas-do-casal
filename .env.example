# Copie para .env.local (no seu computador) e cadastre as mesmas variáveis na Vercel.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pluggy (dashboard.pluggy.ai → sua aplicação) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Qualquer texto aleatório comprido. Protege o webhook.
PLUGGY_WEBHOOK_SECRET=

# URL do app na Vercel (sem barra no fim). Em dev, deixe vazio.
NEXT_PUBLIC_APP_URL=

# --- O casal ---
# Pessoa 1 é a dona dos dados; pessoa 2 é o par.
NEXT_PUBLIC_PESSOA1_NOME=
NEXT_PUBLIC_PESSOA2_NOME=
PESSOA1_EMAIL=
PESSOA2_EMAIL=
# Foto é opcional (caminho em /public, ex. /avatars/maria.png, ou URL). Sem foto aparece a inicial.
NEXT_PUBLIC_PESSOA1_FOTO=
NEXT_PUBLIC_PESSOA2_FOTO=
# User ID da pessoa 1 no Supabase (Authentication → Users), depois do primeiro login.
HOUSEHOLD_OWNER_ID=
# Como os nomes aparecem nos extratos, separados por vírgula, em minúsculas.
# Serve pra reconhecer Pix entre vocês duas (não é gasto nem renda).
NOMES_DO_CASAL=

# --- E-mails automáticos (opcional) ---
RESEND_API_KEY=
CRON_SECRET=
# Destinatários dos avisos, separados por vírgula. Vazio = e-mails das duas pessoas.
ALERT_EMAILS=
